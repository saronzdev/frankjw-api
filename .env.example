# Puerto del servidor (solo desarrollo local)
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Secreto para firmar los JWT (obligatorio)
JWT_SECRET=change-me

# Rondas de bcrypt
SALT_ROUNDS=10

# Turso/libSQL. En desarrollo SOLO se admiten URLs embebidas (:memory: para tests
# o rutas file:); cualquier URL remota libsql:// se ignora y el dev usa file:./local.db.
# En producción (NODE_ENV=production) ambas variables son obligatorias.
TURSO_URL=
TURSO_TOKEN=

# Supabase Storage para las imágenes de los productos.
# Obligatorio en producción (Vercel). En desarrollo es opcional: sin estas variables
# los endpoints /uploads devuelven 503 y la UI muestra el aviso sin tocar el bucket.
# Setup:
#  1. Panel de Supabase > Project Settings > API: copia Project URL -> SUPABASE_URL
#  2. service_role key -> SUPABASE_SERVICE_KEY (NUNCA en el frontend)
#  3. Bucket "pictures" público (los archivos ya existen como URLs públicas)
#  4. Completa también como Environment Variables en Vercel (Production + Preview)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Orígenes CORS adicionales separados por coma (previews de Vercel, etc.)
CORS_EXTRA_ORIGINS=

# Upstash Redis para rate limiting distribuido (opcional).
# Sin config, el rate limit corre en memoria por instancia (ok en desarrollo local;
# en Vercel serverless cada instancia tendría su propio contador).
# Setup:
#  1. Crea cuenta free en https://upstash.com y en la consola crea una base de datos Redis
#     (cualquier región cercana a tus usuarios)
#  2. En la db, en el panel "REST API" copia las credenciales UPSTASH_REDIS_REST_URL
#     y UPSTASH_REDIS_REST_TOKEN
#  3. Completa aquí y también como Environment Variables en Vercel (Production + Preview)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
