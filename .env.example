# Server port (local development only)
PORT=3000

# Environment: development | production
NODE_ENV=development

# Secret used to sign JWTs (required)
JWT_SECRET=change-me

# bcrypt cost rounds
SALT_ROUNDS=10

# Turso/libSQL. In development ONLY embedded URLs are honored (:memory: for the
# test suite or file: paths); any remote libsql:// URL is ignored and dev uses
# file:./local.db instead. In production (NODE_ENV=production) both are required.
TURSO_URL=
TURSO_TOKEN=

# Supabase Storage for product images.
# Required in production (Vercel). Optional in development: without these
# variables the /uploads endpoints return 503 and the UI shows a notice
# without ever touching the production bucket.
# Setup:
#  1. Supabase dashboard > Project Settings > API: copy Project URL -> SUPABASE_URL
#  2. service_role key -> SUPABASE_SERVICE_KEY (NEVER in the frontend)
#  3. Public "pictures" bucket (files are stored/serve as public URLs)
#  4. Also add both as Vercel Environment Variables (Production + Preview)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Extra CORS origins, comma-separated (Vercel previews, etc.)
CORS_EXTRA_ORIGINS=

# Upstash Redis for distributed rate limiting (optional).
# Without config, rate limiting runs in memory per instance (fine for local dev;
# on Vercel serverless each instance keeps its own counter).
# Setup:
#  1. Create a free account at https://upstash.com and create a Redis database
#     in a region close to your users
#  2. In the database, under "REST API", copy UPSTASH_REDIS_REST_URL
#     and UPSTASH_REDIS_REST_TOKEN
#  3. Fill them in here and also as Vercel Environment Variables
#     (Production + Preview)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
